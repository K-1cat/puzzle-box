{% extends "base.jinja" %}

{% block content %}
{% if puzzle == None %}
    <p>Puzzle not found.</p>

{% elif puzzle.puzzle_type.value == 'text' %}
    <h2>{{ puzzle.title }}</h2>
    {% if text_puzzle %}
        <p>{{ text_puzzle.content }}</p>
    {% else %}
        <p>Text puzzle content not found.</p>
    {% endif %}

{% elif puzzle.puzzle_type.value == 'image' %}
    <h2>{{ puzzle.title }}</h2>
    {% if image_puzzle %}
        <img src="{{ url_for('static', filename='uploads/' + image_puzzle.image_filename) }}" alt="{{ puzzle.title }}" style="max-width: 100%; height: auto;"><br><br>
    {% else %}
        <p>Image puzzle not found.</p>
    {% endif %}

{% else %}
    <p>Unsupported puzzle type.</p>
{% endif %}

{% if result %}
    <div style="padding: 12px; margin: 15px 0; border-radius: 5px; {% if result.correct %}background: #d4edda; color: #155724;{% else %}background: #f8d7da; color: #721c24;{% endif %}">
        {{ result.message }}
    </div>
{% endif %}

<form method="POST">
    <label for="answer">Your Answer:</label>
    <input type="text" id="answer" name="answer" placeholder="Enter your answer here..." required><br><br>
    
    <button type="submit">Submit Answer</button>
</form>

<p><a href="{{ url_for('puzzle.list_puzzles') }}">← Back to Puzzles</a></p>
{% endblock %}